{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "../../src",
    "strict": true,
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "paths": {
      "@opencode/plugin": ["./node_modules/@opencode/plugin/dist/promise/index.d.ts"],
      "@opencode/plugin/*": ["./node_modules/@opencode/plugin/dist/*"],
      "*": ["./node_modules/*", "./node_modules/@types/*"]
    },
    "typeRoots": ["./node_modules/@types"],
    "types": ["node"]
  },
  "include": ["../../src/v2/**/*"]
}
